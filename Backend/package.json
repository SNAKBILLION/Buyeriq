{
  "name": "buyeriq-backend",
  "version": "1.0.0",
  "description": "BuyerIQ — Enterprise Buyer Intelligence Platform API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node database/migrate.js",
    "seed": "node database/seeds/seed.js",
    "seed:buyers": "node database/seeds/seed-buyers.js",
    "seed:companies": "node database/seeds/seed-companies.js",
    "seed:all": "node database/seeds/seed.js && node database/seeds/seed-buyers.js && node database/seeds/seed-companies.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "lint": "eslint src/",
    "db:reset": "node database/migrate.js && node database/seeds/seed.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.25.6",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.4",
    "pg": "^8.13.1",
    "uuid": "^11.0.5",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
