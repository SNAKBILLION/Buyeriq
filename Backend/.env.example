# BuyerIQ Backend — Environment Variables
# Copy to .env and fill values

# Database
DATABASE_URL=postgresql://buyeriq:password@localhost:5432/buyeriq

# Redis
REDIS_URL=redis://localhost:6379

# Supabase (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Auth
JWT_SECRET=CHANGE-ME-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Server
PORT=4000
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_FILE=logs/buyeriq.log

# Notifications (optional — system works without these)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_NOTIFY_EMAIL=

# WhatsApp via Twilio (optional)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
ALERT_NOTIFY_WHATSAPP=

# ERP Integration (optional)
ERP_API_URL=
ERP_API_KEY=
ERP_COMPANY_ID=

# Admin Seed (optional — run once)
SEED_ADMIN_EMAIL=admin@senseslifestyle.com
SEED_ADMIN_PASSWORD=
