# ─────────────────────────────────────────────
# BuyerIQ Scraping Infrastructure — Environment
# ─────────────────────────────────────────────

# PostgreSQL
DATABASE_URL=postgresql://buyeriq:password@localhost:5432/buyeriq
DB_HOST=localhost
DB_PORT=5432
DB_NAME=buyeriq
DB_USER=buyeriq
DB_PASSWORD=password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── API Keys ──────────────────────────────────
# UN COMTRADE (free tier: 100 req/day)
COMTRADE_API_KEY=
COMTRADE_BASE_URL=https://comtradeapi.un.org/data/v1

# Frankfurter (no key needed)
FRANKFURTER_BASE_URL=https://api.frankfurter.app

# Amazon PA-API (optional, Phase 2+)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# ── Scraping Config ──────────────────────────
SCRAPER_CONCURRENCY=3
SCRAPER_MIN_DELAY_MS=2000
SCRAPER_MAX_DELAY_MS=8000
SCRAPER_TIMEOUT_MS=30000
SCRAPER_MAX_RETRIES=3

# Proxy (optional)
PROXY_ENABLED=false
PROXY_URL=
PROXY_ROTATION_URL=

# ── Raw Data Storage ─────────────────────────
RAW_DATA_DIR=./raw-data
RAW_DATA_RETENTION_DAYS=30

# ── Worker Config ────────────────────────────
WORKER_CONCURRENCY=2
WORKER_MAX_JOBS_PER_WORKER=50
WORKER_STALLED_INTERVAL=30000

# ── Logging ──────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ── Environment ──────────────────────────────
NODE_ENV=development

# ── AI Intelligence API ──────────────────────
AI_API_PORT=4000
